  <property name="styleSheet">
   <string notr="true">QWidget {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI Variable Display", "Segoe UI", "Inter", sans-serif;
    color: #AFC4D8;
}
QDialog {
    background-color: #071323;
}
QFrame#headerFrame {
    background-color: rgba(12, 27, 48, 0.7);
    border-bottom: 1px solid rgba(39, 216, 247, 0.15);
}
QLabel#lblTitle {
    color: #FFFFFF;
    font-size: 20pt;
    font-weight: 800;
    letter-spacing: -0.5px;
}
QLabel#lblAppIcon {
    background-color: transparent;
    border-radius: 12px;
}
QGroupBox, QFrame[cssClass="card"] {
    background-color: #12243B;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 20px;
    padding: 24px;
    margin-top: 45px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    top: 20px;
    left: 24px;
    color: #FFFFFF;
    font-weight: 700;
    font-size: 14pt;
    letter-spacing: -0.3px;
}
QFrame#leftSidebarFrame {
    background-color: transparent;
}
QPushButton[cssClass="sidebar"] {
    text-align: left;
    padding: 14px 20px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    font-weight: 600;
    font-size: 11pt;
    color: #AFC4D8;
    margin-bottom: 8px;
}
QPushButton[cssClass="sidebar"]:hover {
    background-color: rgba(39, 216, 247, 0.08);
    border: 1px solid rgba(39, 216, 247, 0.3);
    color: #FFFFFF;
}
QPushButton[cssClass="sidebarActive"] {
    text-align: left;
    padding: 14px 20px;
    background: #0C1B30;
    border: 1px solid rgba(39, 216, 247, 0.4);
    border-left: 4px solid #27D8F7;
    border-radius: 12px;
    font-weight: 700;
    font-size: 11pt;
    color: #FFFFFF;
    margin-bottom: 8px;
}
QPushButton {
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    padding: 10px 24px;
    color: #AFC4D8;
    font-weight: 600;
    font-size: 10pt;
}
QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #FFFFFF;
}
QPushButton:pressed {
    background-color: rgba(0, 0, 0, 0.2);
}
QPushButton[cssClass="accent"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #00b5d8, stop:1 #319795);
    color: white;
    border: none;
    border-radius: 10px;
}
QPushButton[cssClass="accent"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #319795, stop:1 #2c7a7b);
}
QTabWidget::pane {
    border: none;
    background: transparent;
}
QTabBar::tab {
    background: transparent;
    color: #AFC4D8;
    padding: 16px 24px;
    border: none;
    font-size: 12pt;
    font-weight: 600;
    margin-right: 8px;
}
QTabBar::tab:selected {
    color: #FFFFFF;
    background-color: transparent;
    border-bottom: 3px solid #27D8F7;
}
QTabBar::tab:hover:!selected {
    color: #FFFFFF;
    background-color: rgba(255,255,255,0.03);
    border-radius: 12px;
}
QFrame#statusBarFrame {
    background-color: rgba(12, 27, 48, 0.6);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding: 6px 0px;
}
QFrame#statusBarFrame QLabel {
    color: #AFC4D8;
    font-size: 9pt;
    font-weight: 500;
}
QListWidget {
    background-color: transparent;
    border: none;
}
QListWidget::item {
    padding: 12px;
    border-radius: 10px;
    color: #AFC4D8;
    font-weight: 500;
}
QListWidget::item:hover {
    background-color: rgba(39, 216, 247, 0.05);
    color: #FFFFFF;
}
QListWidget::item:selected {
    background-color: rgba(39, 216, 247, 0.1);
    border: 1px solid rgba(39, 216, 247, 0.2);
    color: #FFFFFF;
    font-weight: 600;
}
QComboBox, QLineEdit, QDateEdit, QSpinBox, QDoubleSpinBox, QAbstractSpinBox {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 8px 12px;
    background-color: #0C1B30;
    color: #FFFFFF;
    font-size: 10pt;
}
QComboBox:hover, QLineEdit:hover, QDateEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QAbstractSpinBox:hover {
    border: 1px solid rgba(39, 216, 247, 0.3);
}
QComboBox QAbstractItemView {
    background-color: #12243B;
    color: #FFFFFF;
    selection-background-color: transparent;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    outline: none;
    padding: 4px;
}
QComboBox QAbstractItemView::item {
    padding: 8px 12px;
    border-radius: 4px;
    color: #FFFFFF;
}
QComboBox QAbstractItemView::item:hover {
    background-color: #1E3A5F;
}
QComboBox QAbstractItemView::item:selected {
    background-color: #1E3A5F;
    color: #27D8F7;
    border-left: 3px solid #27D8F7;
}
QSplitter::handle {
    background-color: transparent;
    width: 24px;
}
QLineEdit, QDateEdit, QSpinBox, QDoubleSpinBox, QAbstractSpinBox {
    color: #FFFFFF;
    selection-color: #FFFFFF;
    selection-background-color: #27D8F7;
}
QLineEdit::placeholder, QDateEdit::placeholder, QSpinBox::placeholder, QDoubleSpinBox::placeholder, QAbstractSpinBox::placeholder {
    color: #B8C6D8;
}
QLineEdit:disabled, QDateEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QAbstractSpinBox:disabled, QComboBox:disabled {
    color: #7E8EA5;
}
</string>
