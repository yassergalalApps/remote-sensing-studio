  <property name="styleSheet">
   <string notr="true">QWidget {
    font-family: 'Segoe UI', 'Inter', 'Noto Sans', sans-serif;
    color: #FFFFFF;
}
QDialog {
    background-color: #0C1B30;
}
QFrame#headerFrame {
    background-color: #12243B;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}
QLabel#lblTitle {
    color: #2B6CB0;
    font-size: 16pt;
    font-weight: bold;
}
QLabel {
    font-size: 10pt;
}
QLabel#lblCurrentProject, QLabel#lblGEEStatusHeader {
    color: #D7E3F4;
    font-size: 9pt;
}
QPushButton {
    background-color: #12243B;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    padding: 8px 16px;
    color: #D7E3F4;
    font-weight: 500;
}
QPushButton:hover {
    background-color: #1E3A5F;
    border: 1px solid rgba(255, 255, 255, 0.1);
}
QPushButton:pressed {
    background-color: rgba(255, 255, 255, 0.1);
}
QPushButton[cssClass="accent"] {
    background-color: #2B6CB0;
    color: white;
    border: none;
}
QPushButton[cssClass="accent"]:hover {
    background-color: #2C5282;
}
QPushButton[cssClass="sidebar"] {
    text-align: left;
    padding: 10px 15px;
    background: transparent;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    color: #D7E3F4;
}
QPushButton[cssClass="sidebar"]:hover {
    background-color: rgba(43, 108, 176, 0.08);
    color: #2B6CB0;
}
QGroupBox, QFrame[cssClass="card"] {
    background-color: #12243B;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    margin-top: 3ex;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0px 5px;
    left: 10px;
    color: #FFFFFF;
    font-weight: 600;
    font-size: 11pt;
}
QTabWidget::pane {
    border: none;
    background: transparent;
}
QTabBar::tab {
    background: transparent;
    color: #B8C6D8;
    padding: 12px 20px;
    border: none;
    font-size: 11pt;
    font-weight: 500;
}
QTabBar::tab:selected {
    color: #2B6CB0;
    border-bottom: 3px solid #2B6CB0;
    font-weight: 600;
}
QTabBar::tab:hover:!selected {
    color: #D7E3F4;
    background-color: #1E3A5F;
    border-radius: 6px;
}
QFrame#statusBarFrame {
    background-color: #12243B;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
}
QFrame#statusBarFrame QLabel {
    color: #B8C6D8;
    font-size: 9pt;
}
QListWidget {
    background-color: transparent;
    border: none;
}
QListWidget::item {
    padding: 8px;
    border-radius: 6px;
    color: #D7E3F4;
}
QListWidget::item:hover {
    background-color: #1E3A5F;
}
QListWidget::item:selected {
    background-color: rgba(43, 108, 176, 0.1);
    color: #2B6CB0;
    font-weight: bold;
}
QComboBox {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    padding: 4px 8px;
    background-color: #12243B;
}
QComboBox:hover {
    border: 1px solid rgba(255, 255, 255, 0.1);
}
QComboBox QAbstractItemView {
    background-color: #12243B;
    color: #FFFFFF;
    selection-background-color: transparent;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    outline: none;
    padding: 4px;
}
QComboBox QAbstractItemView::item {
    padding: 8px 12px;
    border-radius: 4px;
    color: #FFFFFF;
}
QComboBox QAbstractItemView::item:hover {
    background-color: #1E3A5F;
}
QComboBox QAbstractItemView::item:selected {
    background-color: #1E3A5F;
    color: #27D8F7;
    border-left: 3px solid #27D8F7;
}
QLineEdit {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    padding: 6px 12px;
    background-color: #12243B;
}
QLineEdit:focus {
    border: 1px solid #2B6CB0;
}
QSplitter::handle {
    background-color: rgba(255, 255, 255, 0.1);
    width: 1px;
}
QLineEdit, QDateEdit, QSpinBox, QDoubleSpinBox, QAbstractSpinBox {
    color: #FFFFFF;
    selection-color: #FFFFFF;
    selection-background-color: #27D8F7;
}
QLineEdit::placeholder, QDateEdit::placeholder, QSpinBox::placeholder, QDoubleSpinBox::placeholder, QAbstractSpinBox::placeholder {
    color: #B8C6D8;
}
QLineEdit:disabled, QDateEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QAbstractSpinBox:disabled, QComboBox:disabled {
    color: #7E8EA5;
}
</string>
