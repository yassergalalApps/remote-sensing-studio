<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>AnalysisWizardDialog</class>
 <widget class="QDialog" name="AnalysisWizardDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>900</width>
    <height>650</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Analysis Wizard</string>
  </property>
  <property name="styleSheet">
   <string>
QDialog {
    background-color: #0C1B30;
    font-family: 'Segoe UI', system-ui, sans-serif;
}
QGroupBox {
    background-color: #12243B;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    margin-top: 16px;
    font-size: 11pt;
    font-weight: 600;
    color: #FFFFFF;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: #D7E3F4;
}
QPushButton {
    padding: 8px 16px;
    border-radius: 6px;
    font-weight: 600;
    font-size: 9pt;
    background-color: #12243B;
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #D7E3F4;
}
QPushButton:hover {
    background-color: #1E3A5F;
}
QPushButton[cssClass="accent"] {
    background-color: #27D8F7;
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 8px;
    font-size: 10pt;
}
QPushButton[cssClass="accent"]:hover {
    background-color: #27D8F7;
}
QTableView, QTableWidget {
    background-color: #1E3A5F;
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    gridline-color: rgba(255, 255, 255, 0.10);
    alternate-background-color: #0C1B30;
    selection-background-color: rgba(39, 216, 247, 0.2);
    selection-color: #FFFFFF;
}

QTableView::item, QTableWidget::item {
    color: #FFFFFF;
    background-color: transparent;
}
QTableView::item:selected, QTableWidget::item:selected {
    color: #FFFFFF;
    background-color: rgba(39, 216, 247, 0.2);
}
QTableView::item:alternate, QTableWidget::item:alternate {
    color: #FFFFFF;
}
QTableView::item:disabled, QTableWidget::item:disabled {
    color: #AFC4D8;
}

QHeaderView::section {
    background-color: #0C1B30;
    padding: 8px;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    font-weight: 600;
    color: #FFFFFF;
}
QLabel#lblTitle {
    font-size: 18pt;
    font-weight: 700;
    color: #FFFFFF;
}
QComboBox QAbstractItemView {
    background-color: #12243B;
    color: #FFFFFF;
    selection-background-color: transparent;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    outline: none;
    padding: 4px;
}
QComboBox QAbstractItemView::item {
    padding: 8px 12px;
    border-radius: 4px;
    color: #FFFFFF;
}
QComboBox QAbstractItemView::item:hover {
    background-color: #1E3A5F;
}
QComboBox QAbstractItemView::item:selected {
    background-color: #1E3A5F;
    color: #27D8F7;
    border-left: 3px solid #27D8F7;
}
QLineEdit, QDateEdit, QSpinBox, QDoubleSpinBox, QAbstractSpinBox {
    color: #FFFFFF;
    selection-color: #FFFFFF;
    selection-background-color: #27D8F7;
}
QLineEdit::placeholder, QDateEdit::placeholder, QSpinBox::placeholder, QDoubleSpinBox::placeholder, QAbstractSpinBox::placeholder {
    color: #B8C6D8;
}
QLineEdit:disabled, QDateEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QAbstractSpinBox:disabled, QComboBox:disabled {
    color: #7E8EA5;
}
   </string>
  </property>
  <layout class="QVBoxLayout" name="mainLayout">
   <property name="spacing"><number>20</number></property>
   <property name="margin"><number>30</number></property>
   
   <item>
    <widget class="QLabel" name="lblTitle">
     <property name="text"><string>Analysis Wizard</string></property>
    </widget>
   </item>
   
   <item>
    <widget class="QStackedWidget" name="stackedWidget">
     
     <!-- Page 1: Configuration -->
     <widget class="QWidget" name="pageConfig">
      <layout class="QVBoxLayout">
       <property name="margin"><number>0</number></property>
       <item>
        <widget class="QScrollArea">
         <property name="widgetResizable"><bool>true</bool></property>
         <property name="frameShape"><enum>QFrame::NoFrame</enum></property>
         <widget class="QWidget" name="scrollContent">
          <layout class="QVBoxLayout">
           
           <item>
            <widget class="QGroupBox" name="grpParameters">
             <property name="title"><string>Spatial &amp; Temporal Parameters</string></property>
             <layout class="QVBoxLayout">
              <property name="spacing"><number>15</number></property>
              
              <item>
               <layout class="QHBoxLayout">
                <item><widget class="QLabel"><property name="text"><string>Area of Interest (AOI):</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
                <item>
                 <widget class="QComboBox" name="cmbAoi">
                  <item><property name="text"><string>Current Map Extent</string></property></item>
                  <item><property name="text"><string>Selected Features in Active Layer</string></property></item>
                  <item><property name="text"><string>Active Layer Bounding Box</string></property></item>
                  <item><property name="text"><string>Draw Polygon</string></property></item>
                  <item><property name="text"><string>Browse Vector File</string></property></item>
                 </widget>
                </item>
               </layout>
              </item>
              
              <item>
               <widget class="QStackedWidget" name="stkAoiControls">
                <property name="maximumSize"><size><width>16777215</width><height>50</height></size></property>
                <widget class="QWidget" name="pageAoiEmpty"><layout class="QVBoxLayout"><property name="margin"><number>0</number></property></layout></widget>
                <widget class="QWidget" name="pageAoiDraw">
                 <layout class="QHBoxLayout">
                  <property name="margin"><number>0</number></property>
                  <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>150</width><height>20</height></size></property></spacer></item>
                  <item><widget class="QPushButton" name="btnStartDrawing"><property name="text"><string>Start Drawing on Map</string></property></widget></item>
                  <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
                 </layout>
                </widget>
                <widget class="QWidget" name="pageAoiFile">
                 <layout class="QHBoxLayout">
                  <property name="margin"><number>0</number></property>
                  <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>150</width><height>20</height></size></property></spacer></item>
                  <item><widget class="QLineEdit" name="txtAoiFile"><property name="readOnly"><bool>true</bool></property><property name="placeholderText"><string>Select .shp, .gpkg, .geojson...</string></property></widget></item>
                  <item><widget class="QPushButton" name="btnBrowseAoi"><property name="text"><string>Browse...</string></property></widget></item>
                 </layout>
                </widget>
               </widget>
              </item>
              
              <item>
               <layout class="QHBoxLayout">
                <item><widget class="QLabel"><property name="text"><string>Dataset:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
                <item><widget class="QComboBox" name="cmbDataset"></widget></item>
               </layout>
              </item>
              
              <item>
               <layout class="QHBoxLayout">
                <item><widget class="QLabel"><property name="text"><string>Start Date:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
                <item><widget class="QDateEdit" name="dateStart"><property name="displayFormat"><string>yyyy-MM-dd</string></property><property name="calendarPopup"><bool>true</bool></property></widget></item>
               </layout>
              </item>
              
              <item>
               <layout class="QHBoxLayout">
                <item><widget class="QLabel"><property name="text"><string>End Date:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
                <item><widget class="QDateEdit" name="dateEnd"><property name="displayFormat"><string>yyyy-MM-dd</string></property><property name="calendarPopup"><bool>true</bool></property></widget></item>
               </layout>
              </item>
              
             </layout>
            </widget>
           </item>

           <item>
            <widget class="QGroupBox" name="grpQuality">
             <property name="title"><string>Image Quality Filters</string></property>
             <layout class="QVBoxLayout">
              <property name="spacing"><number>15</number></property>
              
              <item>
               <layout class="QHBoxLayout">
                <item><widget class="QLabel"><property name="text"><string>Max Cloud Cover (%):</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
                <item>
                 <widget class="QSpinBox" name="spinCloud">
                  <property name="maximum"><number>100</number></property>
                  <property name="value"><number>20</number></property>
                 </widget>
                </item>
               </layout>
              </item>
              
              <item>
               <layout class="QHBoxLayout">
                <item><widget class="QLabel"><property name="text"><string>Sort By:</string></property><property name="minimumSize"><size><width>150</width><height>0</height></size></property></widget></item>
                <item>
                 <widget class="QComboBox" name="cmbSort">
                  <item><property name="text"><string>Recommendation Score</string></property></item>
                  <item><property name="text"><string>Lowest Cloud</string></property></item>
                  <item><property name="text"><string>Best Coverage</string></property></item>
                  <item><property name="text"><string>Newest</string></property></item>
                  <item><property name="text"><string>Oldest</string></property></item>
                 </widget>
                </item>
               </layout>
              </item>
             </layout>
            </widget>
           </item>

           <item>
            <widget class="QGroupBox" name="grpAoiSummary">
             <property name="title"><string>AOI Preview</string></property>
             <layout class="QVBoxLayout">
              <item>
               <widget class="QLabel" name="lblAoiSummary">
                <property name="text"><string>&lt;i style="color: #B8C6D8;"&gt;No valid AOI captured yet. Please configure the AOI settings.&lt;/i&gt;</string></property>
                <property name="textFormat"><enum>Qt::RichText</enum></property>
               </widget>
              </item>
             </layout>
            </widget>
           </item>

           <item><spacer><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>40</height></size></property></spacer></item>
          </layout>
         </widget>
        </widget>
       </item>
      </layout>
     </widget>
     
     <!-- Page 2: Scene Selection -->
     <widget class="QWidget" name="pageScene">
      <layout class="QHBoxLayout">
       <property name="spacing"><number>20</number></property>
       <item>
        <layout class="QVBoxLayout">
         
         <item>
          <layout class="QHBoxLayout">
           <item><widget class="QLabel"><property name="text"><string>&lt;b&gt;Acquisition Mode:&lt;/b&gt;</string></property></widget></item>
           <item><widget class="QRadioButton" name="radSingle"><property name="text"><string>Single Scene</string></property><property name="checked"><bool>true</bool></property></widget></item>
           <item><widget class="QRadioButton" name="radCollection"><property name="text"><string>Image Collection (Composite)</string></property></widget></item>
           <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
          </layout>
         </item>
         
         <item>
          <widget class="QWidget" name="panelComposite">
           <layout class="QHBoxLayout">
            <property name="margin"><number>0</number></property>
            <item><widget class="QLabel"><property name="text"><string>Compositing Method:</string></property></widget></item>
            <item>
             <widget class="QComboBox" name="cmbComposite">
              <item><property name="text"><string>Median</string></property></item>
              <item><property name="text"><string>Mean</string></property></item>
              <item><property name="text"><string>Mosaic</string></property></item>
              <item><property name="text"><string>Quality Mosaic</string></property></item>
              <item><property name="text"><string>Best Pixel</string></property></item>
             </widget>
            </item>
            <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
           </layout>
          </widget>
         </item>

         <item>
          <widget class="QWidget" name="panelSelectionControls">
           <layout class="QHBoxLayout">
            <property name="margin"><number>0</number></property>
            <item><widget class="QPushButton" name="btnSelectAll"><property name="text"><string>Select All</string></property></widget></item>
            <item><widget class="QPushButton" name="btnDeselectAll"><property name="text"><string>Deselect All</string></property></widget></item>
            <item><widget class="QPushButton" name="btnInvertSelection"><property name="text"><string>Invert Selection</string></property></widget></item>
            <item><widget class="QPushButton" name="btnRecommendOnly"><property name="text"><string>Use Recommended</string></property></widget></item>
            <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
           </layout>
          </widget>
         </item>
         
         <item><widget class="QLabel"><property name="text"><string>&lt;b&gt;Available Scenes&lt;/b&gt;</string></property></widget></item>
         <item>
          <widget class="QTableView" name="tblScenes">
           <!-- Selection mode modified dynamically, and items are checkable -->
           <property name="selectionBehavior"><enum>QAbstractItemView::SelectRows</enum></property>
           <property name="selectionMode"><enum>QAbstractItemView::SingleSelection</enum></property>
           <property name="alternatingRowColors"><bool>true</bool></property>
           <property name="editTriggers"><set>QAbstractItemView::NoEditTriggers</set></property>
          </widget>
         </item>
         
         <item>
          <layout class="QHBoxLayout">
           <item><widget class="QLabel"><property name="text"><string>&lt;b&gt;Output Visualization:&lt;/b&gt;</string></property></widget></item>
           <item>
            <widget class="QComboBox" name="cmbOutputMode">
             <item>
              <property name="text">
               <string>GeoTIFF Download</string>
              </property>
             </item>
            </widget>
           </item>
           <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
          </layout>
         </item>
         
         <item>
          <layout class="QVBoxLayout">
           <property name="spacing"><number>10</number></property>
           <item>
            <layout class="QHBoxLayout">
             <item><widget class="QLabel"><property name="text"><string>Download Method:</string></property></widget></item>
             <item><widget class="QRadioButton" name="radDirectDownload"><property name="text"><string>Download Directly</string></property><property name="checked"><bool>true</bool></property></widget></item>
             <item><widget class="QRadioButton" name="radGoogleDrive"><property name="text"><string>Send to Google Drive</string></property></widget></item>
             <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
            </layout>
           </item>
           <item>
            <widget class="QPushButton" name="btnDownloadScene">
             <property name="text"><string>Download Scene</string></property>
             <property name="cssClass" stdset="0"><string>accent</string></property>
             <property name="minimumSize"><size><width>150</width><height>0</height></size></property>
             <property name="maximumSize"><size><width>200</width><height>16777215</height></size></property>
            </widget>
           </item>
          </layout>
         </item>
         
        </layout>
       </item>
       
       <item>
        <widget class="QGroupBox" name="grpPreview">
         <property name="title"><string>Scene Preview</string></property>
         <property name="minimumSize"><size><width>350</width><height>0</height></size></property>
         <layout class="QVBoxLayout">
          <item>
           <widget class="QLabel" name="lblThumbnail">
            <property name="text"><string>Select a scene to preview</string></property>
            <property name="alignment"><set>Qt::AlignCenter</set></property>
            <property name="minimumSize"><size><width>300</width><height>300</height></size></property>
            <property name="styleSheet"><string>background-color: #1E3A5F; border-radius: 8px;</string></property>
           </widget>
          </item>
          <item>
           <widget class="QTextBrowser" name="txtMetadata">
            <property name="styleSheet"><string>border: none; background: transparent; font-size: 10pt;</string></property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
      </layout>
     </widget>
     
     <!-- Page 3: Progress -->
     <widget class="QWidget" name="pageProgress">
      <layout class="QVBoxLayout">
       <item><spacer><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>40</height></size></property></spacer></item>
       <item>
        <widget class="QLabel" name="lblStatus">
         <property name="text"><string>Preparing Analysis...</string></property>
         <property name="alignment"><set>Qt::AlignCenter</set></property>
         <property name="styleSheet"><string>font-size: 14pt; font-weight: 600; color: #27D8F7;</string></property>
        </widget>
       </item>
       <item>
        <widget class="QProgressBar" name="progressBar">
         <property name="value"><number>0</number></property>
         <property name="textVisible"><bool>false</bool></property>
         <property name="minimumSize"><size><width>0</width><height>15</height></size></property>
         <property name="maximumSize"><size><width>16777215</width><height>15</height></size></property>
         <property name="styleSheet"><string>
QProgressBar {
    border: none;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 7px;
}
QProgressBar::chunk {
    background-color: #27D8F7;
    border-radius: 7px;
}
         </string></property>
        </widget>
       </item>
       <item><spacer><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>40</height></size></property></spacer></item>
      </layout>
     </widget>

     <!-- Page 4: Summary -->
     <widget class="QWidget" name="pageSummary">
      <layout class="QVBoxLayout">
       <item>
        <widget class="QLabel" name="lblSummaryTitle">
         <property name="text"><string>Analysis Complete!</string></property>
         <property name="alignment"><set>Qt::AlignCenter</set></property>
         <property name="styleSheet"><string>font-size: 18pt; font-weight: bold; color: #10B981;</string></property>
        </widget>
       </item>
       <item>
        <widget class="QTextBrowser" name="txtSummary">
         <property name="styleSheet"><string>border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; background-color: #12243B; font-size: 11pt; padding: 10px; color: #FFFFFF;</string></property>
        </widget>
       </item>
      </layout>
     </widget>
     
    </widget>
   </item>
   
   <item>
    <widget class="QFrame" name="buttonFrame">
     <layout class="QHBoxLayout">
      <property name="margin"><number>0</number></property>
      <item>
       <widget class="QPushButton" name="btnCancel">
        <property name="text"><string>Cancel</string></property>
        <property name="cssClass" stdset="0"><string>none</string></property>
       </widget>
      </item>
      <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
      <item>
       <widget class="QPushButton" name="btnBack">
        <property name="text"><string>Back</string></property>
        <property name="cssClass" stdset="0"><string>none</string></property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="btnNext">
        <property name="text"><string>Search Images</string></property>
        <property name="cssClass" stdset="0"><string>accent</string></property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="btnFinish">
        <property name="text"><string>Finish</string></property>
        <property name="cssClass" stdset="0"><string>accent</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
