  <property name="styleSheet">
   <string notr="true">
#WelcomeDialog {
    background-color: #040D1F;
}
#WelcomeDialog QWidget {
    font-family: 'Inter', 'Segoe UI', sans-serif;
}

/* Header */
#WelcomeDialog QLabel#lblHeaderTitle {
    color: #ffffff;
    font-size: 14pt;
    font-weight: bold;
    letter-spacing: 1px;
}
#WelcomeDialog QLabel#lblHeaderSubtitle {
    color: #4fd1c5;
    font-size: 10pt;
    font-weight: 500;
}

/* Text */
#WelcomeDialog QLabel#lblWelcome {
    color: #4fd1c5;
    font-size: 10pt;
    font-weight: bold;
    letter-spacing: 2px;
}
#WelcomeDialog QLabel#lblTitle {
    color: #ffffff;
    font-size: 26pt;
    font-weight: 800;
}
#WelcomeDialog QLabel#lblDesc {
    color: #B8C6D8;
    font-size: 11pt;
    line-height: 1.5;
}
#WelcomeDialog QLabel#lblSection {
    color: #38b2ac;
    font-size: 10pt;
    font-weight: bold;
    letter-spacing: 1.5px;
}

/* Radio Button Cards */
#WelcomeDialog QRadioButton {
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(79, 209, 197, 0.3);
    border-radius: 12px;
    padding: 16px;
    color: #ffffff;
    font-size: 13pt;
    font-weight: 600;
}
#WelcomeDialog QRadioButton::indicator {
    width: 22px;
    height: 22px;
    border-radius: 11px;
    border: 2px solid #4fd1c5;
    background: transparent;
    margin-right: 12px;
}
#WelcomeDialog QRadioButton::indicator:checked {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.4, fx:0.5, fy:0.5, stop:0 #4fd1c5, stop:1 transparent);
    border: 2px solid #81e6d9;
}
#WelcomeDialog QRadioButton:hover {
    background-color: rgba(79, 209, 197, 0.08);
    border: 1px solid rgba(79, 209, 197, 0.6);
}
#WelcomeDialog QRadioButton:checked {
    background-color: rgba(79, 209, 197, 0.1);
    border: 1px solid #4fd1c5;
}

/* Continue Button */
#WelcomeDialog QPushButton#btnContinue {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #00b5d8, stop:1 #319795);
    border: none;
    border-radius: 8px;
    color: white;
    font-size: 12pt;
    font-weight: bold;
    padding: 10px 24px;
}
#WelcomeDialog QPushButton#btnContinue:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #319795, stop:1 #2c7a7b);
}
#WelcomeDialog QPushButton#btnContinue:pressed {
    background: #285e61;
}

/* Footer Items */
#WelcomeDialog QLabel#lblSecure, #WelcomeDialog QLabel#lblPowerful, #WelcomeDialog QLabel#lblAccurate {
    color: #B8C6D8;
    font-size: 10pt;
    font-weight: 500;
}
QLineEdit, QDateEdit, QSpinBox, QDoubleSpinBox, QAbstractSpinBox {
    color: #FFFFFF;
    selection-color: #FFFFFF;
    selection-background-color: #27D8F7;
}
QLineEdit::placeholder, QDateEdit::placeholder, QSpinBox::placeholder, QDoubleSpinBox::placeholder, QAbstractSpinBox::placeholder {
    color: #B8C6D8;
}
QLineEdit:disabled, QDateEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QAbstractSpinBox:disabled, QComboBox:disabled {
    color: #7E8EA5;
}
   </string>
