{
    "schema_version": 1,
    "engine_version": 1,
    "minimum_plugin_version": "1.0",
    "id": "AWEInsh",
    "metadata": {
        "display_name": "Automated Water Extraction Index (No Shadow)",
        "scientific_name": "AWEInsh",
        "category": "Spectral Index",
        "description": "Automated Water Extraction Index (Non-shadow version)",
        "units": "Index",
        "order": 4
    },
    "workspace": "water",
    "formula": {
        "engine": "expression",
        "expression": "4 * (GREEN - SWIR1) - (0.25 * NIR + 2.75 * SWIR2)",
        "required_bands": [
            "GREEN",
            "NIR",
            "SWIR1",
            "SWIR2"
        ],
        "parameters": {}
    },
    "default_parameters": {
        "threshold": 0.0
    },
    "visualization": {
        "renderer": "continuous",
        "palette": "Water",
        "minimum": -1.0,
        "maximum": 1.0,
        "nodata": "transparent",
        "renderer_family": "water_detection"
    },
    "classification": {
        "mode": "continuous"
    },
    "capabilities": {
        "statistics": true,
        "histogram": true,
        "classification": true,
        "area": true,
        "timeseries": false,
        "change_detection": false,
        "export": true,
        "renderer": true
    },
    "report": {
        "positive_class": "Water",
        "negative_class": "Non-Water"
    },
    "supported_satellites": [
        "Sentinel-2",
        "Landsat-8",
        "Landsat-9"
    ],
    "input_semantics": {
        "domain": "optical",
        "unit": "reflectance",
        "representation": "physical"
    },
    "safety": {
        "input_validity": {
            "optical_min": 0.0,
            "thermal_min": null
        },
        "base_denominators": [],
        "derived_terms": [],
        "complex_denominators": [],
        "sqrt_domains": [],
        "output_validity": {
            "enabled": false
        }
    }
}