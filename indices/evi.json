{
    "schema_version": 1,
    "engine_version": 1,
    "minimum_plugin_version": "1.0",
    "id": "EVI",
    "metadata": {
        "display_name": "Enhanced Vegetation Index",
        "scientific_name": "EVI",
        "category": "Spectral Index",
        "description": "Optimized index for regions with high biomass",
        "units": "Index",
        "order": 2
    },
    "workspace": "vegetation",
    "formula": {
        "engine": "expression",
        "expression": "G * ((NIR - RED) / (NIR + C1 * RED - C2 * BLUE + L))",
        "required_bands": [
            "NIR",
            "RED",
            "BLUE"
        ],
        "parameters": {
            "G": 2.5,
            "C1": 6.0,
            "C2": 7.5,
            "L": 1.0
        }
    },
    "default_parameters": {
        "threshold": 0.2
    },
    "visualization": {
        "renderer": "continuous",
        "palette": "RdYlGn",
        "minimum": -0.2,
        "maximum": 1.0,
        "nodata": "transparent",
        "renderer_family": "vegetation"
    },
    "classification": {
        "mode": "continuous"
    },
    "capabilities": {
        "statistics": true,
        "histogram": true,
        "classification": true,
        "area": true,
        "timeseries": false,
        "change_detection": false,
        "export": true,
        "renderer": true
    },
    "report": {
        "positive_class": "Dense Vegetation",
        "negative_class": "Water/Bare Soil"
    },
    "supported_satellites": [
        "Sentinel-2",
        "Landsat-8",
        "Landsat-9"
    ],
    "input_semantics": {
        "domain": "optical",
        "unit": "reflectance",
        "representation": "physical"
    },
    "safety": {
        "input_validity": {
            "optical_min": 0.0,
            "thermal_min": null
        },
        "base_denominators": [
            {
                "id": "denom_evi",
                "expression": "NIR + C1 * RED - C2 * BLUE + L",
                "epsilon": 1e-02
            }
        ],
        "derived_terms": [],
        "complex_denominators": [],
        "sqrt_domains": [],
        "output_validity": {
            "enabled": true,
            "min": -0.2,
            "max": 1.0
        }
    }
}